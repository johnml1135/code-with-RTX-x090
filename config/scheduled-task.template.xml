<!-- Template only. Register-BonsaiTask.ps1 fills the current user and absolute
     deployment paths at registration time; no credentials or tokens belong here. -->
<Task xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task" version="1.4">
  <RegistrationInfo><Description>Bonsai local loopback server supervisor</Description></RegistrationInfo>
  <Triggers><LogonTrigger><Delay>PT30S</Delay></LogonTrigger></Triggers>
  <Principals><Principal id="Author"><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure><Interval>PT1M</Interval><Count>10</Count></RestartOnFailure>
  </Settings>
  <Actions Context="Author"><Exec><Command>POWERSHELL_EXE</Command><Arguments>-NoProfile -ExecutionPolicy Bypass -File WATCH_SCRIPT -ConfigPath CONFIG_PATH</Arguments><WorkingDirectory>DEPLOYMENT_ROOT</WorkingDirectory></Exec></Actions>
</Task>

